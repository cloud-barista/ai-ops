{
    "swagger": "2.0",
    "info": {
        "description": "Discover, normalize, filter, and rank infrastructure resources from an ApplicationProfile and resource observations.",
        "title": "AI-MCMP Resource Ops API",
        "contact": {},
        "license": {
            "name": "Apache 2.0",
            "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "0.2.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/resource-recommendations": {
            "post": {
                "description": "Project application requirements into resource constraints, collect and normalize observations, filter unavailable or insufficient resources, and rank the remaining candidates. This endpoint returns recommendations without deploying applications.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Resource Recommendations"
                ],
                "summary": "Recommend infrastructure resources for an ApplicationProfile",
                "operationId": "RecommendResourcesFromProfile",
                "parameters": [
                    {
                        "description": "ApplicationProfile, selectors, and ranking preferences",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/resource.ProfileRecommendationRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/resource.ResourceRecommendation"
                        }
                    },
                    "400": {
                        "description": "Malformed JSON, unknown fields, or request body over 1 MiB",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "422": {
                        "description": "Invalid ApplicationProfile or resource query",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "502": {
                        "description": "Resource source unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Service"
                ],
                "summary": "Check Resource Ops health and capabilities",
                "operationId": "GetResourceOpsHealth",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/legacy/api/v1/resource-recommendations": {
            "post": {
                "description": "Compatibility endpoint for clients that supply resource constraints directly.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Legacy"
                ],
                "summary": "Recommend resources from a legacy ResourceQuery",
                "operationId": "RecommendResourcesFromLegacyQuery",
                "deprecated": true,
                "parameters": [
                    {
                        "description": "Legacy resource query",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/resource.ResourceQuery"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/resource.ResourceRecommendation"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "422": {
                        "description": "Unprocessable Entity",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    }
                }
            }
        },
        "/openapi.yaml": {
            "get": {
                "produces": [
                    "text/yaml"
                ],
                "tags": [
                    "Service"
                ],
                "summary": "Download the Resource Ops API specification",

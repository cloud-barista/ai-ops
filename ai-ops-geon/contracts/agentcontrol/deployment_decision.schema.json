{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-mcmp.example.org/schema/deployment-decision-1.0.json",
  "title": "DeploymentDecision",
  "type": "object",
  "required": ["decision_id", "action", "reason", "reasoning_mode", "confidence", "requires_manifest_generation", "created_at"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "action": {
      "type": "string",
      "enum": [
        "DEPLOY", "RETRY", "REJECT",
        "ACCEPT_RECOMMENDATION", "REQUEST_ALTERNATIVE_RESOURCE",
        "ADJUST_RESOURCE_REQUIREMENT", "RETRY_DEPLOYMENT", "REQUEST_NEW_VM",
        "REJECT_DEPLOYMENT", "REQUEST_USER_CLARIFICATION"
      ]
    },
    "reason": {"type": "string", "minLength": 1},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "reasoning_mode": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "selected_candidate_id": {"type": "string"},
    "correction_request": {"type": "object"},
    "requires_manifest_generation": {"type": "boolean"},
    "retry_policy": {
      "type": "object",
      "required": ["max_attempts"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1},
        "attempt": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}

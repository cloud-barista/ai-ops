{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-mcmp.example.org/schema/deployment-feedback-1.0.json",
  "title": "DeploymentFeedback",
  "type": "object",
  "required": ["feedback_id", "decision_id", "deployment_id", "outcome", "observation_window", "metrics", "created_at"],
  "properties": {
    "feedback_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "deployment_id": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "enum": ["SUCCEEDED", "FAILED"]},
    "error_code": {"type": "string"},
    "observation_window": {
      "type": "object",
      "required": ["started_at", "ended_at"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "metrics": {"type": "object"},
    "slo_violations": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KHU Runtime SSH Credential Create Request",
  "description": "프로세스 메모리에만 등록되고 서버 재시작 시 소멸하는 SSH Credential 요청이다. Secret은 응답, 로그, 일반 파일 저장소에 기록하지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credential_id",
    "credential_type",
    "auth_type",
    "ssh_user",
    "host_key_fingerprint"
  ],
  "properties": {
    "credential_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "credential_type": {
      "const": "ssh"
    },
    "auth_type": {
      "enum": [
        "private_key",
        "password"
      ]
    },
    "ssh_user": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "host_key_fingerprint": {
      "type": "string",
      "minLength": 50,
      "maxLength": 50,
      "pattern": "^SHA256:[A-Za-z0-9+/]{43}$",
      "description": "신뢰 가능한 채널로 확인한 대상 SSH host public key의 canonical OpenSSH SHA256 fingerprint"
    },
    "private_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "writeOnly": true
    },
    "private_key_passphrase": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "writeOnly": true
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "writeOnly": true
    },
    "ssh_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300,
      "default": 30
    }
  },
  "oneOf": [
    {
      "properties": {
        "auth_type": {
          "const": "private_key"
        }
      },
      "required": [
        "private_key"
      ],
      "not": {
        "properties": {
          "password": {}
        },
        "required": [
          "password"
        ]
      }
    },
    {
      "properties": {
        "auth_type": {
          "const": "password"
        }
      },
      "required": [
        "password"
      ],
      "not": {
        "anyOf": [
          {
            "properties": {
              "private_key": {}
            },
            "required": [
              "private_key"
            ]
          },
          {
            "properties": {
              "private_key_passphrase": {}
            },
            "required": [
              "private_key_passphrase"
            ]
          }
        ]
      }
    }
  ]
}

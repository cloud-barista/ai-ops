{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KHU Deployment Request",
  "type": "object",
  "anyOf": [
    {
      "required": [
        "app_version_id"
      ]
    },
    {
      "required": [
        "manifest"
      ]
    }
  ],
  "properties": {
    "app_id": {
      "type": "string"
    },
    "app_version_id": {
      "type": "string"
    },
    "target_profile_id": {
      "type": "string",
      "description": "Optional Target Profile hint; App Deployer selects a ready matching target when omitted."
    },
    "requested_by": {
      "type": "string"
    },
    "parameters": {
      "type": "object"
    },
    "manifest": {
      "$ref": "deployment_manifest.schema.json"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KHU Deployment Request",
  "type": "object",
  "anyOf": [
    {
      "required": [
        "app_version_id"
      ]
    },
    {
      "required": [
        "manifest"
      ]
    }
  ],
  "properties": {
    "app_id": {
      "type": "string"
    },
    "app_version_id": {
      "type": "string"
    },
    "target_profile_id": {
      "type": "string",
      "description": "Optional Target Profile hint; App Deployer selects a ready matching target when omitted."
    },
    "requested_by": {
      "type": "string"
    },
    "parameters": {
      "type": "object"
    },
    "requirements": {
      "$ref": "#/$defs/deployment_requirements"
    },
    "manifest": {
      "$ref": "deployment_manifest.schema.json"
    }
  },
  "$defs": {
    "deployment_requirements": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" },
            "gpu": { "type": "string" },
            "storage": { "type": "string" }
          }
        },
        "runtime": { "type": "string" },
        "accelerator": { "enum": ["none", "nvidia"] },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "slo": { "type": "object" },
        "cost_policy": { "type": "string", "enum": ["min_cost"], "default": "min_cost" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}

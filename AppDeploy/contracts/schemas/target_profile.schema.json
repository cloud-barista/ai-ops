{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KHU Target Profile",
  "type": "object",
  "required": [
    "target_profile_id",
    "csp",
    "vm",
    "runtime"
  ],
  "properties": {
    "target_profile_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "csp": {
      "enum": [
        "aws",
        "azure",
        "gcp",
        "etri",
        "local",
        "mock"
      ]
    },
    "region": {
      "type": "string"
    },
    "os": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "vm": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "ssh_port": {
          "type": "integer"
        },
        "credential_ref": {
          "type": "string",
		  "minLength": 9,
		  "maxLength": 256,
		  "pattern": "^cred://[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$",
          "description": "cred://runtime/{credential_id}는 Credential API가 현재 프로세스 메모리에서 해석하며 서버 재시작 시 소멸한다. 그 밖의 참조는 환경변수 Credential resolver로 fallback하고, Target Profile에는 실제 Secret을 저장하지 않는다."
        }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "runtime_type": {
          "enum": [
            "mock",
            "local",
            "cpu",
            "gpu",
            "aiinfra"
          ]
        },
        "accelerator": {
          "enum": [
            "none",
            "nvidia"
          ]
        },
        "operating_mode": {
          "enum": [
            "local_mock",
            "local_process",
            "dry_run",
            "vm_process",
            "remote_api"
          ]
        }
      }
    },
    "gpu": {
      "type": "object",
      "properties": {
        "vendor": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "driver_required": {
          "type": "boolean"
        }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "artifact_dir": {
          "type": "string"
        },
        "model_dir": {
          "type": "string"
        },
        "log_dir": {
          "type": "string"
        }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "service_port_range": {
          "type": "string"
        }
      }
    },
    "vm_type": {
      "enum": ["Cloud", "Local", "Mock"]
    },
    "status": {
      "enum": ["READY", "BUSY", "UNAVAILABLE"]
    },
    "capacity": {
      "$ref": "#/$defs/resource_capacity"
    },
    "allocated": {
      "$ref": "#/$defs/resource_allocation"
    },
    "supported_runtimes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cost_weight": {
      "type": "number",
      "minimum": 0
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "resource_capacity": {
      "type": "object",
      "properties": {
        "cpu_cores": { "type": "number", "minimum": 0 },
        "memory_bytes": { "type": "integer", "minimum": 0 },
        "gpu_count": { "type": "integer", "minimum": 0 },
        "gpu_type": { "type": "string" },
        "storage_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "resource_allocation": {
      "type": "object",
      "properties": {
        "cpu_cores": { "type": "number", "minimum": 0 },
        "memory_bytes": { "type": "integer", "minimum": 0 },
        "gpu_count": { "type": "integer", "minimum": 0 },
        "storage_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

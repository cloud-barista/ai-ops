# AI App Deployer runtime configuration template.
# Copy values into your local environment manager; do not commit real secrets.

# API server
AIAPP_SERVER_PORT=8080

# Optional JSON file-backed store. Leave empty for in-memory storage.
AIAPP_STORE_PATH=

# Runtime runner selection: dry-run or ssh.
AIAPP_CPUVM_RUNNER=dry-run
AIAPP_GPUVM_RUNNER=dry-run

# Default SSH timeout used by CPU/GPU VM runners.
AIAPP_SSH_DEFAULT_TIMEOUT=30s

# Credential management requires loopback peer + loopback Host and same-origin by default.
# Enable remote access only behind a TLS and authenticated reverse proxy.
AIAPP_CREDENTIAL_API_ALLOW_REMOTE=false

# Package builder. Relative paths are resolved from the AppDeploy module root.
AIAPP_AIOPS_ROOT=../ai-ops-geon
AIAPP_PACKAGE_OUTPUT_DIR=tmp/appdeploy-packages
AIAPP_PACKAGE_BUILD_TIMEOUT=2m
AIAPP_PACKAGE_MAX_UPLOAD_BYTES=52428800

# Provider selection. ETRI mode requires the corresponding endpoint variables
# below; it never silently falls back to local mode.
RESOURCE_PROVIDER=local
PLACEMENT_PROVIDER=local
ETRI_RESOURCE_ENDPOINT=
ETRI_PLACEMENT_ENDPOINT=
ETRI_CREDENTIAL_REF=
ETRI_TIMEOUT=30s

# Headless local process runtime working directory. The local VM target can
# also set storage.artifact_dir explicitly.
AIAPP_LOCAL_RUNTIME_WORK_DIR=tmp/local-runtime

# Credential references are normalized from values such as cred://local/cpu-vm-001.
# Example prefix: AIAPP_CREDENTIAL_CRED_LOCAL_CPU_VM_001
# Required for ENV SSH credentials. Obtain this public OpenSSH SHA256 fingerprint
# through a trusted channel that is separate from the connection being verified.
AIAPP_CREDENTIAL_CRED_LOCAL_CPU_VM_001_SSH_USER=
AIAPP_CREDENTIAL_CRED_LOCAL_CPU_VM_001_SSH_HOST_KEY_FINGERPRINT=
AIAPP_CREDENTIAL_CRED_LOCAL_CPU_VM_001_SSH_KEY_PATH=
AIAPP_CREDENTIAL_CRED_LOCAL_CPU_VM_001_SSH_KEY_PASSPHRASE=
AIAPP_CREDENTIAL_CRED_LOCAL_CPU_VM_001_SSH_PASSWORD=
AIAPP_CREDENTIAL_CRED_LOCAL_CPU_VM_001_SSH_TIMEOUT=30s

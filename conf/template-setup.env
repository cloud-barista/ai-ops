# AI-MCMP service-control runtime configuration template
#
# Copy this file to a local .env file only when needed.
# Do not commit real credentials, API keys, kubeconfig paths, or cloud secrets.

# Repository root used by the Go service-control API.
AIOPS_REPO_ROOT=/path/to/Kyunghee-aiops-go

# Optional override for the OpenAPI YAML served by /openapi.yaml.
AIOPS_OPENAPI_PATH=/path/to/Kyunghee-aiops-go/docs/submission/openapi_service_control.yaml

# Echo HTTP server port.
PORT=8080

# LLM_Op ApplicationProfile API configuration template
# Do not commit real credentials or API keys.

AIOPS_REPO_ROOT=/path/to/llmop
AIOPS_OPENAPI_PATH=/path/to/llmop/go/service-control-api/docs/swagger/swagger.yaml
AIOPS_LLM_CANDIDATES_PATH=/path/to/llmop/config/application_profile_llm_candidates.json
AIOPS_OPS_LLM_BENCHMARK_PATH=/path/to/llmop/config/ops_llm_benchmark.json
AIOPS_LLMOP_CANDIDATE_ID=qwen3.5-profile-generator
AIOPS_LLMOP_MAX_LLM_ATTEMPTS=2
AIOPS_LLMOP_MAX_REQUEST_BYTES=131072
AIOPS_BIND_ADDRESS=127.0.0.1
PORT=8080

# If the configured candidate uses api_key_env, export that environment
# variable only in the local runtime environment. Never place its value here.

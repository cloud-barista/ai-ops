{
    "swagger": "2.0",
    "info": {
        "description": "Go Echo API for AI LLM operation management, agent registry management, CPU/GPU VM placement, and AI application deployment-control planning.",
        "title": "AI-Ops Service Control API",
        "contact": {},
        "license": {
            "name": "Apache 2.0",
            "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "0.1"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/agents": {
            "get": {
                "description": "Return the configured bounded-action agent registry.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Agent Registry"
                ],
                "summary": "List registered AI operation agents",
                "operationId": "GetAgents",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Register an external agent endpoint, capabilities, and bounded actions in process memory.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Agent Registry"
                ],
                "summary": "Register an external AI operation agent",
                "operationId": "PostAgent",
                "parameters": [
                    {
                        "description": "External agent registration",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.ExternalAgentRegistrationRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/api.AgentProfile"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/agents/{name}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Agent Registry"
                ],
                "summary": "Get a registered AI operation agent",
                "operationId": "GetAgent",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Agent name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.AgentProfile"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/agents/{name}/actions/{action}/validate": {
            "post": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Agent Registry"
                ],
                "summary": "Validate an action against an agent boundary",
                "operationId": "PostAgentActionValidate",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Agent name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Action identifier",
                        "name": "action",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/agents/{name}/invocations/plan": {
            "post": {
                "description": "Validate the registered capability and bounded action, then return a non-executing invocation plan.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Agent Registry"
                ],
                "summary": "Build a validated external-agent invocation plan",
                "operationId": "PostAgentInvocationPlan",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Agent name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Invocation plan request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.AgentInvocationPlanRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.AgentInvocationPlan"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/apps/deployment-plan": {
            "post": {
                "description": "Build a CPU/GPU VM-oriented deployment and control plan for the selected workload.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI Application Deployment"
                ],
                "summary": "Build an AI application deployment plan",
                "operationId": "PostDeploymentPlan",
                "parameters": [
                    {
                        "description": "Inference workload request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.WorkloadRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.DeploymentPlanResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/apps/placement": {
            "post": {
                "description": "Recommend a CPU/GPU VM target for an AI application workload.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI Application Deployment"
                ],
                "summary": "Recommend CPU/GPU VM placement",
                "operationId": "PostAppPlacement",
                "parameters": [
                    {
                        "description": "Inference workload request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.WorkloadRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.PlacementResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/ops-llm/select": {
            "post": {
                "description": "Rank Ops LLM candidates using the configured service-control benchmark policy.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "LLM Operation Management"
                ],
                "summary": "Select an Ops LLM policy candidate",
                "operationId": "PostOpsLLMSelect",
                "parameters": [
                    {
                        "description": "Ops LLM selection request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.OpsLLMSelectRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.OpsLLMSelectionResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/service-operations/run": {
            "post": {
                "description": "Execute the Go service-control flow across LLM selection, agent checks, CPU/GPU placement, and deployment-control planning.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Service Control"
                ],
                "summary": "Run service-control operation planning",
                "operationId": "PostServiceOperationsRun",
                "parameters": [
                    {
                        "description": "Service operation request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.ServiceOperationsRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.ServiceOperationsResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "description": "Return a lightweight readiness response for the Go service-control API.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Service Control"
                ],
                "summary": "Check service-control API health",
